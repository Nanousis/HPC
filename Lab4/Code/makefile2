# Makefile for CUDA CLAHE project

# Compiler and flags
NVCC     := nvcc
CFLAGS   := -O4
LDFLAGS  :=
LDLIBS   := -lm

# Project files
SRC      := main.cu clahe.cu
OBJ      := $(SRC:.cu=.o)
TARGET   := clahe_gpu

# Default target
all: $(TARGET)

# Link step
$(TARGET): $(OBJ)
	$(NVCC) $(LDFLAGS) $(OBJ) -o $@ $(LDLIBS)

# Compilation rule
%.o: %.cu clahe.h
	$(NVCC) $(CFLAGS) -c $< -o $@

# Clean build files
clean:
	rm -f $(OBJ) $(TARGET)

# Convenience run target
run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run
